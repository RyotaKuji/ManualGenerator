<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ManualGenerator"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
        mc:Ignorable="d"
        Title="MainWindow"
        IsTabStop="False"
        FontFamily="Noto Sans JP"
        FontWeight="Normal"
        Background="Transparent">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
	</Window.Resources>

	<WindowChrome.WindowChrome>
		<WindowChrome CaptionHeight="55"
		              UseAeroCaptionButtons="True"
		              GlassFrameThickness="0,55,0,0"/>
	</WindowChrome.WindowChrome>

	<!-- ウィンドウ全体 -->
	<Border BorderBrush="Gray"
	        BorderThickness="1">

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="55"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- タイトルバー -->
			<StackPanel Grid.Row="0"
			            VerticalAlignment="Stretch"
			            HorizontalAlignment="Stretch"
			            Orientation="Horizontal"
			            Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVis}}"
			            Panel.ZIndex="200">

				<local:StyledButton Content="&#xEC52;"
				                    FontFamily="Segoe MDL2 Assets"
				                    FontSize="18"
				                    Width="50"
				                    FilterColor="Black"
				                    BorderThickness="0"
				                    Click="Back"
				                    WindowChrome.IsHitTestVisibleInChrome="True"/>

				<syncfusion:SplitButtonAdv Label="保存"
				                           ToolTip="保存(Ctrl+S)"
				                           Command="{Binding SaveCommand}"
				                           FontSize="13"
				                           SmallIcon="/Images/Save.png"
				                           IconWidth="30"
				                           DropDirection="BottomLeft"
				                           Padding="0,5"
				                           BorderThickness="0"
				                           WindowChrome.IsHitTestVisibleInChrome="True">
					<syncfusion:DropDownMenuGroup>
						<syncfusion:DropDownMenuGroup.Resources>
							<Style TargetType="{x:Type syncfusion:DropDownMenuItem}">
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="{x:Type syncfusion:DropDownMenuItem}">
											<Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=syncfusion:DropDownMenuItem}}">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="40"/>
													<ColumnDefinition Width="50"/>
												</Grid.ColumnDefinitions>
												<Grid.RowDefinitions>
													<RowDefinition Height="30"/>
												</Grid.RowDefinitions>
												<Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=syncfusion:DropDownMenuItem}}"
												       Grid.Column="0"
												       HorizontalAlignment="Center"
												       VerticalAlignment="Center"
												       Margin="10,5,2,5"
												       RenderOptions.BitmapScalingMode="HighQuality"/>
												<Label Content="{Binding Header, RelativeSource={RelativeSource AncestorType=syncfusion:DropDownMenuItem}}"
												       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=syncfusion:DropDownMenuItem}}"
												       FontSize="13"
												       FontFamily="Noto Sans JP"
												       Grid.Column="1"/>
											</Grid>
											<ControlTemplate.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter Property="Opacity" Value="0.8"/>
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
						</syncfusion:DropDownMenuGroup.Resources>

						<syncfusion:DropDownMenuItem Header="公開"
						                             Icon="/Images/Publish.png"
						                             Background="CornflowerBlue"
						                             Foreground="White"
						                             Margin="0,0,0,1"/>
						<syncfusion:DropDownMenuItem Header="削除"
						                             Icon="/Images/Delete.png"
						                             Background="White"
						                             Foreground="#ff4538"/>
					</syncfusion:DropDownMenuGroup>
				</syncfusion:SplitButtonAdv>

			</StackPanel>

			<!-- タイトルバー下部 -->
			<Rectangle Height="16"
			           Panel.ZIndex="120"
			           HorizontalAlignment="Stretch"
			           Fill="White"
			           VerticalAlignment="Bottom"/>
			<Rectangle Grid.Row="0"
			           Grid.ColumnSpan="3"
			           Height="5"
			           VerticalAlignment="Bottom"
			           Panel.ZIndex="100"
			           Fill="White"
			           Opacity="0.7">
				<Rectangle.Effect>
					<DropShadowEffect Color="Black"
					                  BlurRadius="15"
					                  ShadowDepth="2"
					                  Direction="270"
					                  Opacity="0.5"/>
				</Rectangle.Effect>
			</Rectangle>

			<!-- ページ -->
			<Frame x:Name="Frame"
			       NavigationUIVisibility="Hidden"
			       IsTabStop="False"
			       Grid.Row="1"
			       Background="#d3e3e8"/>
		</Grid>

		<Border.Style>
			<Style TargetType="{x:Type Border}">
				<Style.Triggers>
					<DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
					             Value="Maximized">
						<Setter Property="Margin" Value="7"/>
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</Border.Style>
	</Border>
</Window>
