<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ManualGenerator"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
        mc:Ignorable="d"
        Title="MainWindow"
        IsTabStop="False"
        FontFamily="Noto Sans JP"
        FontWeight="Normal"
        Background="Transparent">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
		<local:BooleanToVisibilityWithInvertConverter x:Key="BoolToVisInvert"/>
	</Window.Resources>

	<WindowChrome.WindowChrome>
		<WindowChrome CaptionHeight="55"
		              UseAeroCaptionButtons="True"
		              GlassFrameThickness="0,55,0,0"/>
	</WindowChrome.WindowChrome>

	<!-- ウィンドウ全体 -->
	<Border BorderBrush="Gray"
	        BorderThickness="1">

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="55"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- タイトルバー -->
			<local:TitleBar_EditorPage Grid.Row="0"
			                           Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVis}}"
			                           VerticalAlignment="Stretch"
			                           Panel.ZIndex="200"/>
			<local:TitleBar_ListPage Grid.Row="0"
			                         DataContext="{Binding}"
			                         Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVisInvert}}"
			                         VerticalAlignment="Stretch"
			                         Panel.ZIndex="200"/>

			<!-- タイトルバー下部 -->
			<Rectangle Height="16"
			           Panel.ZIndex="120"
			           HorizontalAlignment="Stretch"
			           Fill="White"
			           VerticalAlignment="Bottom"/>
			<Rectangle Grid.Row="0"
			           Grid.ColumnSpan="3"
			           Height="5"
			           VerticalAlignment="Bottom"
			           Panel.ZIndex="100"
			           Fill="White"
			           Opacity="0.7">
				<Rectangle.Effect>
					<DropShadowEffect Color="Black"
					                  BlurRadius="15"
					                  ShadowDepth="2"
					                  Direction="270"
					                  Opacity="0.5"/>
				</Rectangle.Effect>
			</Rectangle>

			<!-- ページ -->
			<Frame x:Name="Frame"
			       NavigationUIVisibility="Hidden"
			       IsTabStop="False"
			       Grid.Row="1"
			       Background="#d3e3e8"/>
		</Grid>

		<Border.Style>
			<Style TargetType="{x:Type Border}">
				<Style.Triggers>
					<DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
					             Value="Maximized">
						<Setter Property="Margin" Value="7"/>
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</Border.Style>
	</Border>
</Window>
