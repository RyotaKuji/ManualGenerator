<Border x:Class="Section"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ManualGenerator"
        mc:Ignorable="d"
        xmlns:sf="http://schemas.syncfusion.com/wpf"
        Background="White"
        CornerRadius="5">

	<Grid Margin="16">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"
			                  MinWidth="200"/>
			<ColumnDefinition Width="*"
			                  MaxWidth="300"/>
		</Grid.ColumnDefinitions>

		<StackPanel x:Name="LeftColumnPanel"
		            Grid.Column="0"
		            Margin="0,0,12,0"
		            VerticalAlignment="Top">

			<StackPanel.Resources>
				<Thickness x:Key="VerticalMargin">0,0,0,8</Thickness>
			</StackPanel.Resources>

			<ToggleButton IsChecked="{Binding IsHeadline}"
			              HorizontalAlignment="Left"
			              Margin="{StaticResource VerticalMargin}">
				<ToggleButton.Style>
					<Style TargetType="ToggleButton">
						<Setter Property="BorderThickness" Value="0"/>
						<Setter Property="Width" Value="55"/>
						<Setter Property="Height" Value="25"/>
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ToggleButton">
									<Border Background="{TemplateBinding Background}"
									        Padding="10,0"
									        CornerRadius="3">
										<ContentPresenter HorizontalAlignment="Center"
										                  VerticalAlignment="Center"/>
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition Property="IsChecked" Value="False"/>
									<Condition Property="IsMouseOver" Value="False"/>
								</MultiTrigger.Conditions>
								<Setter Property="Content" Value="手順"/>
								<Setter Property="Background" Value="WhiteSmoke"/>
								<Setter Property="Foreground" Value="Gray"/>
							</MultiTrigger>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition Property="IsChecked" Value="True"/>
									<Condition Property="IsMouseOver" Value="False"/>
								</MultiTrigger.Conditions>
								<Setter Property="Content" Value="見出し"/>
								<Setter Property="Background" Value="RoyalBlue"/>
								<Setter Property="Foreground" Value="White"/>
							</MultiTrigger>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition Property="IsChecked" Value="False"/>
									<Condition Property="IsMouseOver" Value="True"/>
								</MultiTrigger.Conditions>
								<Setter Property="Content" Value="手順"/>
								<Setter Property="Background" Value="Gainsboro"/>
								<Setter Property="Foreground" Value="DimGray"/>
							</MultiTrigger>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition Property="IsChecked" Value="True"/>
									<Condition Property="IsMouseOver" Value="True"/>
								</MultiTrigger.Conditions>
								<Setter Property="Content" Value="見出し"/>
								<Setter Property="Background" Value="#365ac9"/>
								<Setter Property="Foreground" Value="White"/>
							</MultiTrigger>
						</Style.Triggers>
					</Style>
				</ToggleButton.Style>
			</ToggleButton>

			<TextBox x:Name="Heading"
			         Text="{Binding Heading}"
			         Grid.Column="0"
			         FontSize="21"
			         Padding="8,4,8,0"
			         VerticalContentAlignment="Center"
			         BorderThickness="0"
			         FontFamily="Yu Gothic"
			         Margin="{StaticResource VerticalMargin}">
				<TextBox.Style>
					<Style TargetType="TextBox">
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="TextBox">
									<Border Background="{TemplateBinding Background}"
									        BorderBrush="{TemplateBinding BorderBrush}"
									        BorderThickness="{TemplateBinding BorderThickness}"
									        CornerRadius="5">
										<ScrollViewer x:Name="PART_ContentHost"/>
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<!--  Process  -->
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding IsHeadline}" Value="False"/>
									<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False"/>
								</MultiDataTrigger.Conditions>
								<Setter Property="FontWeight" Value="Medium"/>
								<Setter Property="Background" Value="Transparent"/>
								<Setter Property="Foreground" Value="Black"/>
							</MultiDataTrigger>
							<!--  Heading  -->
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding IsHeadline}" Value="True"/>
									<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False"/>
								</MultiDataTrigger.Conditions>
								<Setter Property="FontWeight" Value="Bold"/>
								<Setter Property="Background" Value="RoyalBlue"/>
								<Setter Property="Foreground" Value="White"/>
								<Setter Property="CaretBrush" Value="White"/>
							</MultiDataTrigger>
							<!--  Process / MouseOver  -->
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding IsHeadline}" Value="False"/>
									<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
								</MultiDataTrigger.Conditions>
								<Setter Property="FontWeight" Value="Medium"/>
								<Setter Property="Background" Value="WhiteSmoke"/>
								<Setter Property="Foreground" Value="Black"/>
							</MultiDataTrigger>
							<!--  Heading / MouseOver  -->
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding IsHeadline}" Value="True"/>
									<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
								</MultiDataTrigger.Conditions>
								<Setter Property="FontWeight" Value="Bold"/>
								<Setter Property="Background" Value="#3d62d4"/>
								<Setter Property="Foreground" Value="White"/>
								<Setter Property="CaretBrush" Value="White"/>
							</MultiDataTrigger>
						</Style.Triggers>
					</Style>
				</TextBox.Style>
			</TextBox>

			<Separator Height="2"
			           HorizontalAlignment="Stretch"
			           VerticalAlignment="Center"
			           Background="LightGray"
			           Margin="{StaticResource VerticalMargin}"/>

			<RichTextBox Name="DescriptionEditor"
			             MinHeight="40"
			             BorderThickness="0"
			             LostFocus="ConfirmedDescription"
			             IsDocumentEnabled="True">
				<FlowDocument x:Name="FlowDocument"
				              Loaded="SetDescription"
				              PageWidth="{Binding ElementName=DescriptionEditor, Path=Width}"
				              LineHeight="1"
				              FontSize="16"
				              FontFamily="Yu Gothic"
				              FontWeight="Medium"
				              PagePadding="10"/>
				<RichTextBox.ContextMenu>
					<ContextMenu>
						<ContextMenu.Style>
							<Style TargetType="{x:Type ContextMenu}">
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="{x:Type ContextMenu}">
											<Border x:Name="Border"
											        Background="#fcfcfc"
											        BorderBrush="Gainsboro"
											        BorderThickness="1.5"
											        CornerRadius="4"
											        Padding="4,2">
												<StackPanel IsItemsHost="True"
												            Orientation="Horizontal"
												            KeyboardNavigation.DirectionalNavigation="Cycle"/>
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
						</ContextMenu.Style>
						<ContextMenu.Resources>
							<Style x:Key="IconStyle"
							       TargetType="{x:Type TextBlock}">
								<Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
								<Setter Property="HorizontalAlignment" Value="Center"/>
								<Setter Property="VerticalAlignment" Value="Stretch"/>
								<Setter Property="TextAlignment" Value="Left"/>
								<Setter Property="Width" Value="30"/>
								<Setter Property="Height" Value="28"/>
								<Setter Property="FontSize" Value="20"/>
							</Style>
						</ContextMenu.Resources>
						<MenuItem x:Name="RTB_Bold"
						          Command="EditingCommands.ToggleBold"
						          Width="33"
						          Height="28">
							<MenuItem.Icon>
								<TextBlock Text="&#xE8DD;"
								           Style="{StaticResource IconStyle}"/>
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem x:Name="RTB_Underline"
						          Command="EditingCommands.ToggleUnderline"
						          Width="33"
						          Height="28">
							<MenuItem.Icon>
								<TextBlock Text="&#xE8DC;"
								           Style="{StaticResource IconStyle}"/>
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem x:Name="RTB_GrowFont"
						          Command="EditingCommands.IncreaseFontSize"
						          Width="33"
						          Height="28">
							<MenuItem.Icon>
								<TextBlock Text="&#xE8E8;"
								           Style="{StaticResource IconStyle}"/>
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem x:Name="RTB_ShrinkFont"
						          Command="EditingCommands.DecreaseFontSize"
						          Width="33"
						          Height="28">
							<MenuItem.Icon>
								<TextBlock Text="&#xE8E7;"
								           Style="{StaticResource IconStyle}"/>
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem x:Name="RTB_Link"
						          Click="Command_Hyperlink"
						          Width="33"
						          Height="28">
							<MenuItem.Icon>
								<TextBlock Text="&#xE71B;"
								           Style="{StaticResource IconStyle}"/>
							</MenuItem.Icon>
						</MenuItem>
					</ContextMenu>
				</RichTextBox.ContextMenu>
			</RichTextBox>
		</StackPanel>

		<local:StyledButton FontSize="50"
		                    Command="{Binding SelectImageCommand}"
		                    Height="{Binding ElementName=LeftColumnPanel, Path=ActualHeight}"
		                    Grid.Column="1">
			<Grid>
				<Grid.Resources>
					<BooleanToVisibilityConverter x:Key="BoolToVis"/>
					<local:BooleanToVisibilityWithInvertConverter x:Key="BoolToVisInvert"/>
				</Grid.Resources>
				<TextBlock Text="&#xE722;"
				           FontFamily="Segoe MDL2 Assets"
				           FontSize="50"
				           Foreground="DarkGray"
				           Padding="0"
				           VerticalAlignment="Center"
				           HorizontalAlignment="Center"
				           Visibility="{Binding HasImage, Converter={StaticResource BoolToVisInvert}}"/>
				<Border BorderThickness="1"
				        BorderBrush="LightGray"
				        Margin="5"
				        Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
					<Image Source="{Binding ImagePath}"
					       Stretch="Uniform"/>
				</Border>
			</Grid>
		</local:StyledButton>

		<!--  Remove  -->
		<Button x:Name="RemoveButton"
		        Content="✕"
		        Command="{Binding RemoveCommand}"
		        CommandParameter="{Binding}"
		        Width="35"
		        Height="35"
		        VerticalAlignment="Top"
		        HorizontalAlignment="Right"
		        BorderBrush="silver"
		        FontSize="12"
		        Padding="0,4,4,0"
		        FontWeight="ExtraBold"
		        Background="red"
		        Foreground="White"
		        Grid.Column="1">
			<Button.Template>
				<ControlTemplate TargetType="Button">
					<Border x:Name="RemoveButton_Visual"
					        Background="{TemplateBinding Background}"
					        CornerRadius="0,5,0,0"
					        Padding="{TemplateBinding Padding}">
						<ContentPresenter HorizontalAlignment="Right"
						                  VerticalAlignment="Top"/>
						<Border.Style>
							<Style TargetType="Border">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
									             Value="False">
										<Setter Property="Visibility" Value="Hidden"/>
									</DataTrigger>
									<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
									             Value="True">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="RemoveButton_Visual" Property="Opacity" Value="0.8"/>
						</Trigger>
						<Trigger Property="IsMouseOver" Value="False">
							<Setter TargetName="RemoveButton_Visual" Property="Opacity" Value="0.2"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Button.Template>
			<Button.Clip>
				<PathGeometry>
					<PathFigure StartPoint="0,0"
					            IsClosed="True">
						<LineSegment Point="100,0"/>
						<LineSegment Point="100,100"/>
					</PathFigure>
				</PathGeometry>
			</Button.Clip>
			<Button.RenderTransform>
				<TranslateTransform X="16" Y="-16"/>
			</Button.RenderTransform>
		</Button>
	</Grid>
</Border>