<Window x:Class="HyperlinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ManualGenerator"
        mc:Ignorable="d"
        xmlns:sf="http://schemas.syncfusion.com/wpf"
        Title="HyperLinkDialog"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated"
        ContentRendered="Window_ContentRendered"
        Style="{DynamicResource DefaultWindowStyle}">
	<Window.Resources>
		<local:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
		<local:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
		<Style TargetType="{x:Type Window}"
		       x:Key="DefaultWindowStyle">
			<Setter Property="WindowChrome.WindowChrome">
				<Setter.Value>
					<WindowChrome GlassFrameThickness="0"
					              ResizeBorderThickness="0"
					              UseAeroCaptionButtons="False"
					              CaptionHeight="0"/>
				</Setter.Value>
			</Setter>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="UseLayoutRounding" Value="True"/>
		</Style>
	</Window.Resources>
	<Grid Margin="40,30,40,25">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>
		<Grid.Resources>
			<Style x:Key="TextStyle"
			       TargetType="{x:Type TextBlock}">
				<Setter Property="FontFamily" Value="Noto Sans JP"/>
				<Setter Property="FontSize" Value="13"/>
				<Setter Property="FontWeight" Value="Normal"/>
				<Setter Property="TextAlignment" Value="Right"/>
				<Setter Property="VerticalAlignment" Value="Center"/>
				<Setter Property="Margin" Value="0,0,12,0"/>
			</Style>
			<Style x:Key="ErrorMessageStyle"
			       TargetType="{x:Type TextBlock}">
				<Setter Property="FontSize" Value="12"/>
				<Setter Property="FontFamily" Value="Noto Sans JP"/>
				<Setter Property="FontWeight" Value="Light"/>
				<Setter Property="Foreground" Value="Red"/>
				<Setter Property="VerticalAlignment" Value="Bottom"/>
				<Setter Property="Margin" Value="0,5,0,0"/>
			</Style>
			<Style x:Key="InputOuterStyle"
			       TargetType="{x:Type Border}">
				<Setter Property="Width" Value="250"/>
				<Setter Property="Height" Value="30"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="CornerRadius" Value="2"/>
				<Setter Property="BorderBrush" Value="DarkGray"/>
			</Style>
		</Grid.Resources>

		<TextBlock Text="リンクの挿入"
		           Grid.Row="0"
		           Grid.Column="0"
		           Grid.ColumnSpan="2"
		           FontSize="20"
		           FontWeight="Bold"
		           Margin="0,0,0,5"/>

		<TextBlock Text="表示文字列"
		           Grid.Row="2"
		           Grid.Column="0"
		           Style="{StaticResource TextStyle}"/>
		<TextBlock Text="{Binding ErrorMessage_DisplayText}"
		           Grid.Row="1"
		           Grid.Column="1"
		           Style="{StaticResource ErrorMessageStyle}"/>
		<Border Grid.Row="2"
		        Grid.Column="1"
		        Style="{StaticResource InputOuterStyle}">
			<sf:SfTextBoxExt Text="{Binding DisplayText}"
			                 VerticalContentAlignment="Center"
			                 BorderThickness="0"
			                 xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
			                 xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
			                 syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=MaterialLight}"/>
		</Border>

		<TextBlock Text="リンク"
		           Grid.Row="5"
		           Grid.Column="0"
		           Style="{StaticResource TextStyle}"/>
		<TextBlock Text="{Binding ErrorMessage_Uri}"
		           Grid.Row="3"
		           Grid.Column="1"
		           Style="{StaticResource ErrorMessageStyle}"/>
		<StackPanel Grid.Row="4"
		            Grid.Column="1"
		            Margin="0,0,0,4"
		            Orientation="Horizontal"
		            xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
		            xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
		            syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=MaterialLight}">
			<RadioButton Content="外部"
			             IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static local:HyperlinkDialog_VM+UriMode.ExternalUri}, Mode=TwoWay}"
			             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
			             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
			             syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=MaterialLight}"/>
			<RadioButton Content="ページ内"
			             IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static local:HyperlinkDialog_VM+UriMode.SectionUri}, Mode=TwoWay}"
			             Margin="15,0,0,0"
			             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
			             xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
			             syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=MaterialLight}"/>
		</StackPanel>
		<Border Visibility="{Binding Mode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static local:HyperlinkDialog_VM+UriMode.ExternalUri}}"
		        Grid.Row="5"
		        Grid.Column="1"
		        Style="{StaticResource InputOuterStyle}">
			<TextBox Text="{Binding ExternalUri}"
			         VerticalContentAlignment="Center"
			         BorderThickness="0"
			         FontSize="12"
			         xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
			         xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
			         syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=MaterialLight}"/>
		</Border>
		<Border Visibility="{Binding Mode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static local:HyperlinkDialog_VM+UriMode.SectionUri}}"
		        Grid.Row="5"
		        Grid.Column="1"
		        Style="{StaticResource InputOuterStyle}">
			<sf:ComboBoxAdv ItemsSource="{Binding Sections}"
			                DisplayMemberPath="Heading"
			                SelectedValuePath="{Binding}"
			                SelectedItem="{Binding SelectedSection}"
			                VerticalContentAlignment="Center"
			                BorderThickness="0"
			                FontSize="12"
			                xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
			                xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
			                syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=MaterialLight}"/>
		</Border>
		<StackPanel Orientation="Horizontal"
		            HorizontalAlignment="Right"
		            Grid.Row="6"
		            Grid.Column="1"
		            Margin="0,15,5,0">
			<StackPanel.Resources>
				<Style TargetType="{x:Type Button}">
					<Setter Property="FontSize" Value="14"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="{x:Type Button}">
								<Border x:Name="border"
								        Background="Transparent"
								        CornerRadius="2"
								        Padding="10,5">
									<ContentPresenter HorizontalAlignment="Center"
									                  VerticalAlignment="Center"/>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="border" Property="Background" Value="WhiteSmoke"/>
									</Trigger>
									<Trigger Property="IsPressed" Value="True">
										<Setter TargetName="border" Property="Background" Value="#ededed"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</StackPanel.Resources>
			<Button Content="OK"
			        Click="OK_Clicked"/>
			<Button Content="キャンセル"
			        Click="Cancel_Clicked"/>
		</StackPanel>
	</Grid>
</Window>
