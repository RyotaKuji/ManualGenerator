<Window x:Class="HyperlinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ManualGenerator"
        mc:Ignorable="d"
        Title="HyperLinkDialog"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated"
        Style="{DynamicResource DefaultWindowStyle}">
	<Window.Resources>
		<Style TargetType="{x:Type Window}"
		       x:Key="DefaultWindowStyle">
			<Setter Property="WindowChrome.WindowChrome">
				<Setter.Value>
					<WindowChrome GlassFrameThickness="0"
					              ResizeBorderThickness="0"
					              UseAeroCaptionButtons="False"
					              CaptionHeight="0"/>
				</Setter.Value>
			</Setter>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="UseLayoutRounding" Value="True"/>
		</Style>
	</Window.Resources>
	<Grid Margin="40,30,40,25">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>
		<Grid.Resources>
			<Style x:Key="TextStyle"
			       TargetType="{x:Type TextBlock}">
				<Setter Property="FontFamily" Value="Noto Sans JP"/>
				<Setter Property="FontSize" Value="13"/>
				<Setter Property="FontWeight" Value="Normal"/>
				<Setter Property="TextAlignment" Value="Right"/>
				<Setter Property="VerticalAlignment" Value="Center"/>
				<Setter Property="Margin" Value="0,0,12,0"/>
			</Style>
			<Style x:Key="ErrorTextStyle"
			       TargetType="{x:Type TextBlock}">
				<Setter Property="FontSize" Value="12"/>
				<Setter Property="FontFamily" Value="Noto Sans JP"/>
				<Setter Property="FontWeight" Value="Light"/>
				<Setter Property="Foreground" Value="Red"/>
				<Setter Property="VerticalAlignment" Value="Bottom"/>
				<Setter Property="Margin" Value="0,5,0,0"/>
			</Style>
			<Style x:Key="TextBoxStyle"
			       TargetType="{x:Type TextBox}">
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type TextBox}">
							<Border x:Name="border"
							        Width="250"
							        Background="Transparent"
							        CornerRadius="2"
							        Padding="2,4"
							        BorderBrush="DarkGray"
							        BorderThickness="1">
								<ScrollViewer x:Name="PART_ContentHost"/>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</Grid.Resources>
		<TextBlock Text="リンクの挿入"
		           Grid.Row="0"
		           Grid.Column="0"
		           Grid.ColumnSpan="2"
		           FontSize="20"
		           FontWeight="Bold"
		           Margin="0,0,0,5"/>
		<TextBlock Text="表示文字列"
		           Grid.Row="2"
		           Grid.Column="0"
		           Style="{StaticResource TextStyle}"/>
		<TextBlock x:Name="ErrorMessage_DisplayText"
		           Grid.Row="1"
		           Grid.Column="1"
		           Style="{StaticResource ErrorTextStyle}"/>
		<TextBox x:Name="TextBox_DisplayText"
		         Grid.Row="2"
		         Grid.Column="1"
		         Style="{StaticResource TextBoxStyle}"/>

		<TextBlock Text="リンク"
		           Grid.Row="4"
		           Grid.Column="0"
		           Style="{StaticResource TextStyle}"/>
		<TextBlock x:Name="ErrorMessage_Uri"
		           Grid.Row="3"
		           Grid.Column="1"
		           Style="{StaticResource ErrorTextStyle}"/>
		<TextBox x:Name="TextBox_Uri"
		         Grid.Row="4"
		         Grid.Column="1"
		         Style="{StaticResource TextBoxStyle}"/>

		<StackPanel Orientation="Horizontal"
		            HorizontalAlignment="Right"
		            Grid.Row="5"
		            Grid.Column="1"
		            Margin="0,15,5,0">
			<StackPanel.Resources>
				<Style TargetType="{x:Type Button}">
					<Setter Property="FontSize" Value="14"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="{x:Type Button}">
								<Border x:Name="border"
								        Background="Transparent"
								        CornerRadius="2"
								        Padding="10,5">
									<ContentPresenter HorizontalAlignment="Center"
									                  VerticalAlignment="Center"/>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="border" Property="Background" Value="WhiteSmoke"/>
									</Trigger>
									<Trigger Property="IsPressed" Value="True">
										<Setter TargetName="border" Property="Background" Value="#ededed"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</StackPanel.Resources>
			<Button Content="OK"
			        Click="OK_Clicked"/>
			<Button Content="キャンセル"
			        Click="Cancel_Clicked"/>
		</StackPanel>
	</Grid>
</Window>
