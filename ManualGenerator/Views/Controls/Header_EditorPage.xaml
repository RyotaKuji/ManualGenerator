<StackPanel x:Class="Header_EditorPage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
            xmlns:local="clr-namespace:ManualGenerator"
            mc:Ignorable="d"
            xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
            xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
            syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
            Orientation="Horizontal">

	<local:StyledButton Content="&#xEC52;"
	                    FontFamily="Segoe MDL2 Assets"
	                    Command="{Binding BackCommand}"
	                    FontSize="18"
	                    Width="50"
	                    FilterColor="Black"
	                    BorderThickness="0"
	                    WindowChrome.IsHitTestVisibleInChrome="True"/>

	<Grid Margin="5,0">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<syncfusion:SplitButtonAdv x:Name="splitButton"
		                           Grid.Row="1"
		                           Label="保存"
		                           ToolTip="保存 (Ctrl+S)"
		                           Command="{Binding SaveDraftCommand}"
		                           FontFamily="{StaticResource DefaultFontFamily}"
		                           FontSize="14"
		                           Foreground="Black"
		                           SmallIcon="/Images/Save.png"
		                           IconWidth="30"
		                           DropDirection="Left"
		                           Padding="0,5"
		                           BorderThickness="0"
		                           WindowChrome.IsHitTestVisibleInChrome="True">
			<syncfusion:DropDownMenuGroup>
				<syncfusion:DropDownMenuGroup.Resources>
					<Style TargetType="{x:Type syncfusion:DropDownMenuItem}">
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="{x:Type syncfusion:DropDownMenuItem}">
									<Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=syncfusion:DropDownMenuItem}}">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="40"/>
											<ColumnDefinition Width="50"/>
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="30"/>
										</Grid.RowDefinitions>
										<Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=syncfusion:DropDownMenuItem}}"
										       Grid.Column="0"
										       HorizontalAlignment="Center"
										       VerticalAlignment="Center"
										       Margin="10,5,2,5"
										       RenderOptions.BitmapScalingMode="HighQuality"/>
										<Label Content="{Binding Header, RelativeSource={RelativeSource AncestorType=syncfusion:DropDownMenuItem}}"
										       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=syncfusion:DropDownMenuItem}}"
										       FontSize="13"
										       FontFamily="{StaticResource DefaultFontFamily}"
										       Grid.Column="1"/>
									</Grid>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="Opacity" Value="0.8"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</syncfusion:DropDownMenuGroup.Resources>

				<syncfusion:DropDownMenuItem Header="公開"
				                             Command="{Binding PublishDocCommand}"
				                             Icon="/Images/Publish.png"
				                             Foreground="#2f77fa"/>
				<syncfusion:DropDownMenuItem Header="削除"
				                             Icon="/Images/Delete.png"
				                             Background="White"
				                             Foreground="#ff4538"/>
			</syncfusion:DropDownMenuGroup>
		</syncfusion:SplitButtonAdv>

		<Ellipse x:Name="savedSign"
		         Grid.Row="1"
		         Width="7"
		         Height="7"
		         Fill="ForestGreen"
		         VerticalAlignment="Top"
		         HorizontalAlignment="Left"
		         Opacity="0"
		         IsHitTestVisible="False"
		         Margin="-1">
			<Ellipse.Resources>
				<Storyboard x:Key="savedAnimation"
				            Storyboard.TargetName="savedSign">
					<DoubleAnimation Storyboard.TargetProperty="Opacity"
					                 To="1"
					                 Duration="0:0:0"/>
					<DoubleAnimation Storyboard.TargetProperty="Opacity"
					                 To="0"
					                 BeginTime="0:0:1"
					                 Duration="0:0:0.3"/>
				</Storyboard>
			</Ellipse.Resources>
		</Ellipse>
	</Grid>
</StackPanel>
