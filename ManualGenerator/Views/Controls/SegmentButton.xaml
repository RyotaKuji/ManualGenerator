<Grid x:Class="SegmentedButton"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ManualGenerator"
      mc:Ignorable="d"
      Loaded="OnLoaded">

	<Grid.RowDefinitions>
		<RowDefinition Height="*"/>
		<RowDefinition Height="*"/>
	</Grid.RowDefinitions>

	<Grid.Resources>
		<Style x:Key="SegmentStyle"
		       TargetType="{x:Type Border}">
			<Setter Property="BorderBrush" Value="DodgerBlue"/>
			<Setter Property="BorderThickness" Value="1.5"/>
			<Setter Property="Padding" Value="6"/>
			<Style.Triggers>
				<!--  選択  -->
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="DodgerBlue"/>
				</Trigger>
				<!--  非選択  -->
				<MultiDataTrigger>
					<MultiDataTrigger.Conditions>
						<Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True"/>
						<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False"/>
					</MultiDataTrigger.Conditions>
					<Setter Property="Background" Value="White"/>
				</MultiDataTrigger>
				<!--  非選択・マウスオーバー  -->
				<MultiDataTrigger>
					<MultiDataTrigger.Conditions>
						<Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True"/>
						<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
					</MultiDataTrigger.Conditions>
					<Setter Property="Background" Value="WhiteSmoke"/>
				</MultiDataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="LabelStyle"
		       TargetType="{x:Type TextBlock}">
			<Style.Triggers>
				<!--  選択  -->
				<DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Border}}"
				             Value="False">
					<Setter Property="Foreground" Value="White"/>
				</DataTrigger>
				<!--  非選択  -->
				<DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Border}}"
				             Value="True">
					<Setter Property="Foreground" Value="DimGray"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</Grid.Resources>

	<Border x:Name="Segment1"
	        Grid.Row="0"
	        MouseDown="Clicked"
	        Style="{StaticResource SegmentStyle}"
	        CornerRadius="5,5,0,0"
	        ToolTip="{Binding Item1Tooltip, RelativeSource={RelativeSource AncestorType=Grid}}">
		<TextBlock Text="{Binding Item1Text, RelativeSource={RelativeSource AncestorType=Grid}}"
		           FontSize="20"
		           TextAlignment="Center"
		           Style="{StaticResource LabelStyle}"/>
	</Border>

	<Border x:Name="Segment2"
	        Grid.Row="1"
	        MouseDown="Clicked"
	        Style="{StaticResource SegmentStyle}"
	        CornerRadius="0,0,5,5"
	        ToolTip="{Binding Item2Tooltip, RelativeSource={RelativeSource AncestorType=Grid}}">
		<TextBlock Text="{Binding Item2Text, RelativeSource={RelativeSource AncestorType=Grid}}"
		           FontSize="20"
		           TextAlignment="Center"
		           Style="{StaticResource LabelStyle}"/>
	</Border>
</Grid>
