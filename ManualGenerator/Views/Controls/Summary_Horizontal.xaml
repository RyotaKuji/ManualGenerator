<UserControl x:Class="Summary_Horizontal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:ManualGenerator"
             mc:Ignorable="d"
             VerticalAlignment="Top"
             HorizontalAlignment="Stretch"
             Opacity="0">

	<ListBox x:Name="listBox"
	         ItemsSource="{Binding Sections}"
	         HorizontalAlignment="Left"
	         VerticalAlignment="Center"
	         Background="Transparent"
	         BorderThickness="0"
	         SelectionChanged="ListBox_SelectionChanged">
		<ListBox.ItemsPanel>
			<ItemsPanelTemplate>
				<WrapPanel/>
			</ItemsPanelTemplate>
		</ListBox.ItemsPanel>
		<ListBox.Resources>
			<Style TargetType="{x:Type ListBoxItem}">
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ListBoxItem}">
							<Grid Width="165"
							      Height="50"
							      Margin="-5,0">
								<Path x:Name="path"
								      Data="M3,0 H 125 C 130 0, 130 0, 135 5 L 142 12 C 145 15, 145 15, 142 18 L 135 25 C 130 30, 130,30, 125 30 H 3 Q 0 30, 0 28 L 0 3 Q 0 0, 3 0 Z"
								      Stroke="LightGray"
								      StrokeThickness="1"
								      HorizontalAlignment="Center"
								      VerticalAlignment="Center"
								      IsHitTestVisible="False">
									<Path.Effect>
										<DropShadowEffect BlurRadius="10"
										                  ShadowDepth="0"
										                  Color="LightGray"/>
									</Path.Effect>
								</Path>
								<!--  Shadow の分だけ Marginをとる  -->
								<TextBlock Text="{Binding Heading}"
								           HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Foreground="White"
								           Margin="10"
								           Padding="10,5,15,5"
								           TextTrimming="CharacterEllipsis">
									<TextBlock.Clip>
										<PathGeometry Figures="M3,0 H 125 C 130 0, 130 0, 135 5 L 142 12 C 145 15, 145 15, 142 18 L 135 25 C 130 30, 130,30, 125 30 H 3 Q 0 30, 0 28 L 0 3 Q 0 0, 3 0 Z"/>
									</TextBlock.Clip>
								</TextBlock>
							</Grid>

							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="False">
									<Setter TargetName="path" Property="Fill" Value="RoyalBlue"/>
								</Trigger>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="path" Property="Fill" Value="#365ac9"/>
								</Trigger>
								<DataTrigger Binding="{Binding IsHeadline}"
								             Value="False">
									<Setter Property="Visibility" Value="Collapsed"/>
								</DataTrigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ListBox.Resources>
		<i:Interaction.Triggers>
			<i:EventTrigger EventName="SelectionChanged">
				<i:InvokeCommandAction Command="{Binding RequestScrollCommand}"
				                       PassEventArgsToCommand="True"/>
			</i:EventTrigger>
		</i:Interaction.Triggers>
	</ListBox>
</UserControl>