<UserControl x:Class="Summary_Horizontal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:ManualGenerator"
             mc:Ignorable="d"
             VerticalAlignment="Top"
             HorizontalAlignment="Stretch"
             Padding="0,25,0,0"
             Opacity="0">

	<ListBox x:Name="listBox"
	         ItemsSource="{Binding Sections}"
	         HorizontalAlignment="Left"
	         VerticalAlignment="Center"
	         Background="Transparent"
	         BorderThickness="0"
	         SelectionChanged="ListBox_SelectionChanged">
		<ListBox.ItemsPanel>
			<ItemsPanelTemplate>
				<WrapPanel/>
			</ItemsPanelTemplate>
		</ListBox.ItemsPanel>
		<ListBox.Resources>
			<Style TargetType="{x:Type ListBoxItem}">
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ListBoxItem}">
							<Grid x:Name="border"
							      Width="150"
							      Height="30">
								<Grid.Clip>
									<PathGeometry Figures="M3,0 H 125 C 130 0, 130 0, 135 5 L 142 12 C 145 15, 145 15, 142 18 L 135 25 C 130 30, 130,30, 125 30 H 3 Q 0 30, 0 28 L 0 3 Q 0 0, 3 0 Z"/>
								</Grid.Clip>

								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Foreground="White"
								           Padding="8,5,20,5">
									<ContentPresenter Content="{Binding Heading}"/>
								</TextBlock>
								<Path Data="M3,0 H 125 C 130 0, 130 0, 135 5 L 142 12 C 145 15, 145 15, 142 18 L 135 25 C 130 30, 130,30, 125 30 H 3 Q 0 30, 0 28 L 0 3 Q 0 0, 3 0 Z"
								      Stroke="White"
								      StrokeThickness="1"
								      Fill="Transparent"
								      IsHitTestVisible="False"/>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="False">
									<Setter TargetName="border" Property="Background" Value="RoyalBlue"/>
									<Setter TargetName="border" Property="Opacity" Value="0.3"/>
								</Trigger>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="border" Property="Background" Value="#365ac9"/>
								</Trigger>
								<DataTrigger Binding="{Binding IsHeadline}"
								             Value="False">
									<Setter Property="Visibility" Value="Collapsed"/>
								</DataTrigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ListBox.Resources>
		<i:Interaction.Triggers>
			<i:EventTrigger EventName="SelectionChanged">
				<i:InvokeCommandAction Command="{Binding RequestScrollCommand}"
				                       PassEventArgsToCommand="True"/>
			</i:EventTrigger>
		</i:Interaction.Triggers>
	</ListBox>
</UserControl>