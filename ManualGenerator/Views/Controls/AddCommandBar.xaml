<Grid x:Class="AddCommandBar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:local="clr-namespace:ManualGenerator"
      mc:Ignorable="d"
	  MouseUp="OnClick"
      Height="20"
      Background="Transparent">
	<Border x:Name="AddSeparator_Line"
	        HorizontalAlignment="Stretch"
	        Background="DodgerBlue"
	        Height="3">
		<Border.Style>
			<Style TargetType="Border">
				<Style.Triggers>
					<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
					             Value="False">
						<Setter Property="Visibility" Value="Hidden" />
					</DataTrigger>
					<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
					             Value="True">
						<Setter Property="Visibility" Value="Visible" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</Border.Style>
	</Border>
	<Border x:Name="PlusChip"
	        Height="16"
	        CornerRadius="{Binding Path=ActualHeight, ElementName=PlusChip}"
	        Width="{Binding Path=ActualHeight, ElementName=PlusChip}"
	        HorizontalAlignment="Left"
	        VerticalAlignment="Center"
	        Background="DodgerBlue">
		<Border.Style>
			<Style TargetType="Border">
				<Style.Triggers>
					<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
					             Value="False">
						<Setter Property="Visibility" Value="Hidden" />
					</DataTrigger>
					<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
					             Value="True">
						<Setter Property="Visibility" Value="Visible" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</Border.Style>
		<TextBlock Text="＋"
		           FontSize="12"
		           Foreground="White"
		           VerticalAlignment="Center"
		           HorizontalAlignment="Center" />
	</Border>
</Grid>
