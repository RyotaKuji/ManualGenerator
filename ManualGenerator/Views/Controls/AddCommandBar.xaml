<Grid x:Class="AddCommandBar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:local="clr-namespace:ManualGenerator"
      mc:Ignorable="d"
      MouseUp="OnClick"
      Height="20"
      Background="Transparent">
	<Border x:Name="AddSeparator_Line"
	        HorizontalAlignment="Stretch"
	        Background="DodgerBlue"
	        Height="3"
	        CornerRadius="3">
		<Border.Style>
			<Style TargetType="{x:Type Border}">
				<Style.Triggers>
					<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
					             Value="False">
						<Setter Property="Visibility" Value="Hidden"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
					             Value="True">
						<Setter Property="Visibility" Value="Visible"/>
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</Border.Style>
	</Border>
	<Canvas Height="16"
	        Width="16"
	        HorizontalAlignment="Left"
	        VerticalAlignment="Center">
		<Ellipse Fill="DodgerBlue"
		         Height="16"
		         Width="16"/>
		<Rectangle Height="2"
		           Width="10"
		           Canvas.Left="3"
		           Canvas.Top="7"
		           Fill="White"/>
		<Rectangle Height="10"
		           Width="2"
		           Canvas.Left="7"
		           Canvas.Top="3"
		           Fill="White"/>
		<Canvas.Style>
			<Style TargetType="{x:Type Canvas}">
				<Style.Triggers>
					<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
					             Value="False">
						<Setter Property="Visibility" Value="Hidden"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
					             Value="True">
						<Setter Property="Visibility" Value="Visible"/>
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</Canvas.Style>
	</Canvas>
</Grid>
