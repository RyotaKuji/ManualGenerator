<Button x:Class="StyledButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ManualGenerator"
        mc:Ignorable="d"
        Background="White"
        BorderBrush="LightGray"
        BorderThickness="1.5">
	<Button.Style>
		<Style TargetType="{x:Type Button}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<Border x:Name="border"
							        BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=Button}}"
							        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Button}}"
							        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}"
							        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Button}}">
								<ContentPresenter HorizontalAlignment="Center"
								                  VerticalAlignment="Center"/>
							</Border>
							<Border x:Name="filter"
							        Background="{Binding FilterColor, RelativeSource={RelativeSource AncestorType=Button}}"
							        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Button}}"
							        Opacity="0"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="BorderThickness" Value="{Binding BorderThickness_Bold, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<Setter TargetName="border" Property="Padding" Value="0"/>
								<Setter TargetName="filter" Property="Opacity" Value="0.1"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<Setter TargetName="border" Property="Padding" Value="{Binding Padding_BoldDiff, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<Setter TargetName="filter" Property="Opacity" Value="0.15"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=Button}}"/>
								<Setter TargetName="border" Property="Padding" Value="0"/>
								<Setter TargetName="filter" Property="Opacity" Value="0.2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Button.Style>
</Button>
