<Grid x:Class="Header_ListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:local="clr-namespace:ManualGenerator"
      mc:Ignorable="d">

	<Grid.Resources>
		<Style x:Key="TabButtonSytle"
		       TargetType="{x:Type Button}">
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="border"
						        Width="80"
						        BorderThickness="0,0,0,2"
						        BorderBrush="Gray"
						        CornerRadius="0">
							<ContentPresenter VerticalAlignment="Center"
							                  HorizontalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Grid.Resources>

	<Grid.ColumnDefinitions>
		<ColumnDefinition Width="180"/>
		<ColumnDefinition Width="*"/>
		<ColumnDefinition Width="180"/>
	</Grid.ColumnDefinitions>

	<local:StyledButton Grid.Column="0"
	                    Command="{Binding CreateNewCommand}"
	                    HorizontalAlignment="Left"
	                    Margin="15,7"
	                    Width="140"
	                    FontSize="16"
	                    Background="RoyalBlue"
	                    FilterColor="LightSkyBlue"
	                    BorderThickness="0"
	                    WindowChrome.IsHitTestVisibleInChrome="True">
		<StackPanel Orientation="Horizontal">
			<Label Content="＋"
			       FontSize="18"
			       FontWeight="Black"
			       Padding="0"
			       FontFamily="Noto Sans JP"
			       Foreground="WhiteSmoke"
			       VerticalAlignment="Center"
			       Margin="0,0,8,0"/>
			<Label Content="新規作成"
			       FontSize="16"
			       Padding="0"
			       Foreground="WhiteSmoke"
			       VerticalAlignment="Center"/>
		</StackPanel>
	</local:StyledButton>

	<StackPanel Grid.Column="1"
	            Orientation="Horizontal"
	            HorizontalAlignment="Center"
	            WindowChrome.IsHitTestVisibleInChrome="True">
		<Button Content="公開済み"
		        Command="{Binding SwitchIsPublicCommand}"
		        CommandParameter="{x:Static local:Definitions+PubStatus.Published}"
		        Style="{StaticResource TabButtonSytle}"/>
		<Button Content="下書き"
		        Command="{Binding SwitchIsPublicCommand}"
		        CommandParameter="{x:Static local:Definitions+PubStatus.Draft}"
		        Style="{StaticResource TabButtonSytle}"/>
	</StackPanel>

</Grid>
