<Grid x:Class="Header_ListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:local="clr-namespace:ManualGenerator"
      mc:Ignorable="d">

	<Grid.Resources>
		<Style x:Key="SegButtonStyle"
		       TargetType="{x:Type RadioButton}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type RadioButton}">
						<!-- 当たり判定を得るために、Background を設定 -->
						<Border x:Name="border"
						        Width="80"
						        BorderThickness="0,0,0,2"
						        CornerRadius="0"
						        VerticalAlignment="Stretch"
						        HorizontalAlignment="Stretch"
						        Background="Transparent">
							<ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="border" Property="BorderBrush" Value="#7894eb"/>
							</Trigger>
							<Trigger Property="IsChecked" Value="False">
								<Setter TargetName="border" Property="BorderBrush" Value="Transparent"/>
							</Trigger>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition Property="IsMouseOver" Value="True"/>
									<Condition Property="IsChecked" Value="False"/>
								</MultiTrigger.Conditions>
								<MultiTrigger.Setters>
									<Setter TargetName="border" Property="BorderBrush" Value="#507894eb"/>
								</MultiTrigger.Setters>
							</MultiTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Grid.Resources>

	<Grid.ColumnDefinitions>
		<ColumnDefinition Width="180"/>
		<ColumnDefinition Width="*"/>
		<ColumnDefinition Width="180"/>
	</Grid.ColumnDefinitions>

	<local:StyledButton Grid.Column="0"
	                    Command="{Binding CreateNewCommand}"
	                    HorizontalAlignment="Left"
	                    Margin="15,7"
	                    Width="140"
	                    FontSize="16"
	                    Background="RoyalBlue"
	                    FilterColor="LightSkyBlue"
	                    BorderThickness="0"
	                    WindowChrome.IsHitTestVisibleInChrome="True">
		<StackPanel Orientation="Horizontal">
			<Label Content="＋"
			       FontSize="18"
			       FontWeight="Black"
			       Padding="0"
			       FontFamily="Noto Sans JP"
			       Foreground="WhiteSmoke"
			       VerticalAlignment="Center"
			       Margin="0,0,8,0"/>
			<Label Content="新規作成"
			       FontSize="16"
			       Padding="0"
			       Foreground="WhiteSmoke"
			       VerticalAlignment="Center"/>
		</StackPanel>
	</local:StyledButton>

	<StackPanel Grid.Column="1"
	            Orientation="Horizontal"
	            HorizontalAlignment="Center"
	            WindowChrome.IsHitTestVisibleInChrome="True">

		<StackPanel.Resources>
			<local:EnumToBooleanConverter x:Key="EnumToBoolean"/>
		</StackPanel.Resources>

		<RadioButton Content="作成中"
		             Style="{StaticResource SegButtonStyle}"
		             IsChecked="{Binding SelectedPubStatus, Converter={StaticResource EnumToBoolean}, ConverterParameter={x:Static local:Definitions+PubStatus.Draft}}"
		             GroupName="PubStatus"/>
		<RadioButton Content="公開"
		             Style="{StaticResource SegButtonStyle}"
		             IsChecked="{Binding SelectedPubStatus, Converter={StaticResource EnumToBoolean}, ConverterParameter={x:Static local:Definitions+PubStatus.Published}}"
		             GroupName="PubStatus"/>
	</StackPanel>

</Grid>
