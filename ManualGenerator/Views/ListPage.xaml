<UserControl x:Class="ListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:ManualGenerator"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="White"
             mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="50" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="120" />
				<ColumnDefinition Width="*" MaxWidth="300" />
				<ColumnDefinition Width="60" />
			</Grid.ColumnDefinitions>
			<ComboBox Grid.Column="0"
			          DisplayMemberPath="Value"
			          ItemsSource="{Binding SearchMode_Jp}"
			          SelectedValue="{Binding SelectedSearchMode, Mode=TwoWay}"
			          SelectedValuePath="Key" />
			<TextBox Grid.Column="1" Text="{Binding Keyword}" />
			<local:StyledButton Grid.Column="2"
			                    Command="{Binding SearchCommand}"
			                    Content="検索" />
		</Grid>
		<ListBox Grid.Row="1"
		         BorderThickness="0"
		         ItemsSource="{Binding Items}"
		         SelectedItem="{Binding SelectedItem}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<StackPanel>
						<Label Padding="10,5"
						       Content="{Binding Title}"
						       FontFamily="{StaticResource DefaultFontFamily}"
						       FontSize="16" />
						<StackPanel Margin="10,0" Orientation="Horizontal">
							<StackPanel.Resources>
								<Style TargetType="{x:Type Label}">
									<Setter Property="Foreground" Value="LightGray" />
									<Setter Property="FontSize" Value="14" />
									<Setter Property="Padding" Value="5" />
									<Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
								</Style>
							</StackPanel.Resources>
							<Label Content="{Binding Department}" />
							<Label Content="{Binding AuthorName}" />
						</StackPanel>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
			<i:Interaction.Triggers>
				<i:EventTrigger EventName="SelectionChanged">
					<i:InvokeCommandAction Command="{Binding SelectedCommand}" />
				</i:EventTrigger>
			</i:Interaction.Triggers>
		</ListBox>
	</Grid>
</UserControl>
