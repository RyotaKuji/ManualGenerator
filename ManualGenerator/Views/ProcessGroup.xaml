<Border x:Class="ProcessGroup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ManualGenerator"
        mc:Ignorable="d"
        xmlns:sf="http://schemas.syncfusion.com/wpf"
        xmlns:md="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        Background="White"
        CornerRadius="5">
	<Border.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
	</Border.Resources>
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="1.2" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*"
			                  MaxWidth="300" />
		</Grid.ColumnDefinitions>

		<TextBox x:Name="Heading"
		         Text="{Binding Heading}"
		         Grid.Row="0"
		         Grid.Column="1"
		         Height="35"
		         FontSize="25"
		         BorderThickness="0"
		         FontFamily="Yu Gothic"
		         FontWeight="Medium" />

		<Separator Grid.Row="1"
		           Grid.Column="1"
		           HorizontalAlignment="Stretch"
		           VerticalAlignment="Stretch"
		           Background="Gray"
		           Margin="0" />

		<RichTextBox Name="rte"
		             Grid.Row="2"
		             Grid.Column="1"
		             MinHeight="80"
		             BorderThickness="0"
		             TextChanged="Description_TextChanged">
			<FlowDocument x:Name="FlowDocument"
			              Loaded="SetDescription"
			              PageWidth="{Binding ElementName=rte, Path=ActualWidth}"
			              LineHeight="1"
			              FontSize="15"
			              FontFamily="Yu Gothic"
			              FontWeight="Medium" />
		</RichTextBox>

		<local:StyledButton Grid.Row="0"
		                    Grid.Column="2"
		                    Grid.RowSpan="3"
		                    FontSize="50">
			<TextBlock Text="&#xE722;"
			           FontFamily="Segoe MDL2 Assets"
			           FontSize="50"
			           Foreground="DarkGray"
			           Padding="0" />
		</local:StyledButton>

		<!--  Remove  -->
		<Button x:Name="RemoveButton"
		        Content="✕"
		        Command="{Binding RemoveCommand}"
		        CommandParameter="{Binding}"
		        Grid.Row="0"
		        Grid.Column="2"
		        Width="35"
		        Height="35"
		        VerticalAlignment="Top"
		        HorizontalAlignment="Right"
		        BorderBrush="silver"
		        FontSize="12"
		        Padding="0,4,4,0"
		        FontWeight="ExtraBold"
		        Background="red"
		        Foreground="White">
			<Button.Template>
				<ControlTemplate TargetType="Button">
					<Border x:Name="RemoveButton_Visual"
					        Background="{TemplateBinding Background}"
					        CornerRadius="0,5,0,0"
					        Padding="{TemplateBinding Padding}">
						<ContentPresenter HorizontalAlignment="Right"
						                  VerticalAlignment="Top" />
						<Border.Style>
							<Style TargetType="Border">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
									             Value="False">
										<Setter Property="Visibility" Value="Hidden" />
									</DataTrigger>
									<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
									             Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="RemoveButton_Visual" Property="Opacity" Value="0.8" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="False">
							<Setter TargetName="RemoveButton_Visual" Property="Opacity" Value="0.2" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Button.Template>
			<Button.Clip>
				<PathGeometry>
					<PathFigure StartPoint="0,0"
					            IsClosed="True">
						<LineSegment Point="100,0" />
						<LineSegment Point="100,100" />
					</PathFigure>
				</PathGeometry>
			</Button.Clip>
			<Button.RenderTransform>
				<TranslateTransform X="16" Y="-16" />
			</Button.RenderTransform>
		</Button>
	</Grid>
</Border>