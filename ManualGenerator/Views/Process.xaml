<Border x:Class="Process"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ManualGenerator"
        mc:Ignorable="d"
        xmlns:sf="http://schemas.syncfusion.com/wpf"
        Background="White"
        CornerRadius="5">

	<Border.Resources>
		<Thickness x:Key="HorizontalMargin">0,0,12,0</Thickness>
	</Border.Resources>

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="18"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"
			                  MinWidth="200"/>
			<ColumnDefinition Width="*"
			                  MaxWidth="300"/>
		</Grid.ColumnDefinitions>

		<ToggleButton IsChecked="{Binding IsHeading}"
		              HorizontalAlignment="Left">
			<ToggleButton.Style>
				<Style TargetType="ToggleButton">
					<Setter Property="BorderThickness" Value="0"/>
					<Setter Property="Width" Value="55"/>
					<Setter Property="Height" Value="25"/>
					<Setter Property="BorderThickness" Value="0"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="ToggleButton">
								<Border Background="{TemplateBinding Background}"
								        Padding="10,0"
								        CornerRadius="3">
									<ContentPresenter HorizontalAlignment="Center"
									                  VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
					<Style.Triggers>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsChecked" Value="False"/>
								<Condition Property="IsMouseOver" Value="False"/>
							</MultiTrigger.Conditions>
							<Setter Property="Content" Value="手順"/>
							<Setter Property="Background" Value="WhiteSmoke"/>
							<Setter Property="Foreground" Value="Gray"/>
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsChecked" Value="True"/>
								<Condition Property="IsMouseOver" Value="False"/>
							</MultiTrigger.Conditions>
							<Setter Property="Content" Value="見出し"/>
							<Setter Property="Background" Value="RoyalBlue"/>
							<Setter Property="Foreground" Value="White"/>
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsChecked" Value="False"/>
								<Condition Property="IsMouseOver" Value="True"/>
							</MultiTrigger.Conditions>
							<Setter Property="Content" Value="手順"/>
							<Setter Property="Background" Value="Gainsboro"/>
							<Setter Property="Foreground" Value="DimGray"/>
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsChecked" Value="True"/>
								<Condition Property="IsMouseOver" Value="True"/>
							</MultiTrigger.Conditions>
							<Setter Property="Content" Value="見出し"/>
							<Setter Property="Background" Value="#5d80e8"/>
							<Setter Property="Foreground" Value="White"/>
						</MultiTrigger>
					</Style.Triggers>
				</Style>
			</ToggleButton.Style>
		</ToggleButton>
		<TextBox x:Name="Heading"
		         Text="{Binding Heading}"
		         Grid.Row="1"
		         Grid.Column="0"
		         FontSize="21"
		         Padding="8,4,8,0"
		         VerticalContentAlignment="Center"
		         BorderThickness="0"
		         FontFamily="Yu Gothic"
		         Margin="{StaticResource HorizontalMargin}">
			<TextBox.Style>
				<Style TargetType="TextBox">
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="TextBox">
								<Border Background="{TemplateBinding Background}"
								        BorderBrush="{TemplateBinding BorderBrush}"
								        BorderThickness="{TemplateBinding BorderThickness}"
								        CornerRadius="5">
									<ScrollViewer x:Name="PART_ContentHost"/>
								</Border>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
					<Style.Triggers>
						<!-- Process -->
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding IsHeading}" Value="False"/>
								<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False"/>
							</MultiDataTrigger.Conditions>
							<Setter Property="FontWeight" Value="Medium"/>
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="Foreground" Value="Black"/>
						</MultiDataTrigger>
						<!-- Heading -->
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding IsHeading}" Value="True"/>
								<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False"/>
							</MultiDataTrigger.Conditions>
							<Setter Property="FontWeight" Value="Bold"/>
							<Setter Property="Background" Value="RoyalBlue"/>
							<Setter Property="Foreground" Value="White"/>
							<Setter Property="CaretBrush" Value="White"/>
						</MultiDataTrigger>
						<!-- Process / MouseOver -->
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding IsHeading}" Value="False"/>
								<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
							</MultiDataTrigger.Conditions>
							<Setter Property="FontWeight" Value="Medium"/>
							<Setter Property="Background" Value="WhiteSmoke"/>
							<Setter Property="Foreground" Value="Black"/>
						</MultiDataTrigger>
						<!-- Heading / MouseOver -->
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding IsHeading}" Value="True"/>
								<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
							</MultiDataTrigger.Conditions>
							<Setter Property="FontWeight" Value="Bold"/>
							<Setter Property="Background" Value="RoyalBlue"/>
							<Setter Property="Foreground" Value="White"/>
							<Setter Property="CaretBrush" Value="White"/>
						</MultiDataTrigger>
					</Style.Triggers>
				</Style>
			</TextBox.Style>
		</TextBox>

		<Separator Grid.Row="2"
		           Grid.Column="0"
		           Height="2"
		           HorizontalAlignment="Stretch"
		           VerticalAlignment="Center"
		           Background="LightGray"
		           Margin="{StaticResource HorizontalMargin}"/>

		<RichTextBox Name="rte"
		             Grid.Row="3"
		             Grid.Column="0"
		             MinHeight="80"
		             BorderThickness="0"
		             LostFocus="Description_Confirmed"
		             Margin="{StaticResource HorizontalMargin}">
			<FlowDocument x:Name="FlowDocument"
			              Loaded="SetDescription"
			              PageWidth="{Binding ElementName=rte, Path=ActualWidth}"
			              LineHeight="1"
			              FontSize="16"
			              FontFamily="Yu Gothic"
			              FontWeight="Medium"/>
		</RichTextBox>

		<local:StyledButton Grid.Row="0"
		                    Grid.Column="1"
		                    Grid.RowSpan="4"
		                    FontSize="50">
			<TextBlock Text="&#xE722;"
			           FontFamily="Segoe MDL2 Assets"
			           FontSize="50"
			           Foreground="DarkGray"
			           Padding="0"/>
		</local:StyledButton>

		<!-- Remove -->
		<Button x:Name="RemoveButton"
		        Content="✕"
		        Command="{Binding RemoveCommand}"
		        CommandParameter="{Binding}"
		        Grid.Row="0"
		        Grid.Column="1"
		        Width="35"
		        Height="35"
		        VerticalAlignment="Top"
		        HorizontalAlignment="Right"
		        BorderBrush="silver"
		        FontSize="12"
		        Padding="0,4,4,0"
		        FontWeight="ExtraBold"
		        Background="red"
		        Foreground="White">
			<Button.Template>
				<ControlTemplate TargetType="Button">
					<Border x:Name="RemoveButton_Visual"
					        Background="{TemplateBinding Background}"
					        CornerRadius="0,5,0,0"
					        Padding="{TemplateBinding Padding}">
						<ContentPresenter HorizontalAlignment="Right"
						                  VerticalAlignment="Top"/>
						<Border.Style>
							<Style TargetType="Border">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
									             Value="False">
										<Setter Property="Visibility" Value="Hidden"/>
									</DataTrigger>
									<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
									             Value="True">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="RemoveButton_Visual" Property="Opacity" Value="0.8"/>
						</Trigger>
						<Trigger Property="IsMouseOver" Value="False">
							<Setter TargetName="RemoveButton_Visual" Property="Opacity" Value="0.2"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Button.Template>
			<Button.Clip>
				<PathGeometry>
					<PathFigure StartPoint="0,0"
					            IsClosed="True">
						<LineSegment Point="100,0"/>
						<LineSegment Point="100,100"/>
					</PathFigure>
				</PathGeometry>
			</Button.Clip>
			<Button.RenderTransform>
				<TranslateTransform X="16" Y="-16"/>
			</Button.RenderTransform>
		</Button>
	</Grid>
</Border>